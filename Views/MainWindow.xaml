<Window x:Class="NetworkIPManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetworkIPManager.ViewModels"
        Title="Network IP Manager" Height="750" Width="1080"
        MinHeight="600" MinWidth="850"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- HEADER -->
    <Border Grid.Row="0" Margin="0,0,0,18"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Margin="0,0,12,0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#00D4FF" Offset="0"/>
              <GradientStop Color="#0070FF" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Text="🌐" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Network IP Manager" Foreground="White" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="Configurazione schede di rete via PowerShell"
                     Foreground="{StaticResource TextDimBrush}" FontSize="11" FontFamily="Consolas"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding AdminLabel}" Foreground="{StaticResource TextDimBrush}"
                     FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Border CornerRadius="20" Padding="10,4" Background="#1A00D4FF"
                  BorderBrush="#4400D4FF" BorderThickness="1">
            <TextBlock Text="WINDOWS TOOL" Foreground="{StaticResource AccentBrush}"
                       FontFamily="Consolas" FontSize="10"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- CONTENT -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Colonna sinistra: lista + info -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="12" Padding="16"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
              <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0">
                <Ellipse.Effect>
                  <DropShadowEffect Color="#00D4FF" BlurRadius="6" ShadowDepth="0"/>
                </Ellipse.Effect>
              </Ellipse>
              <TextBlock Text="SCHEDE DI RETE RILEVATE"
                         Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="10"/>
              <TextBlock Text="  ⟳" Foreground="{StaticResource AccentBrush}" FontSize="13"
                         Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Adapters}"
                     SelectedItem="{Binding SelectedAdapter}"
                     ItemContainerStyle="{StaticResource NicItem}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7" Margin="0,0,10,0">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="#3300D4FF" Offset="0"/>
                          <GradientStop Color="#330070FF" Offset="1"/>
                        </LinearGradientBrush>
                      </Border.Background>
                      <TextBlock Text="{Binding Icon}" FontSize="14"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                 FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextDimBrush}"
                                 FontFamily="Consolas" FontSize="10"
                                 TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2" CornerRadius="20" Padding="8,3"
                            Margin="6,0,0,0" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background"      Value="#1400FF88"/>
                          <Setter Property="BorderBrush"     Value="#3300FF88"/>
                          <Setter Property="BorderThickness" Value="1"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Down">
                              <Setter Property="Background"  Value="#14FF6B35"/>
                              <Setter Property="BorderBrush" Value="#33FF6B35"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Disabled">
                              <Setter Property="Background"  Value="#14808080"/>
                              <Setter Property="BorderBrush" Value="#33808080"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock FontFamily="Consolas" FontSize="10">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text"       Value="{Binding StatusDisplay}"/>
                            <Setter Property="Foreground" Value="{StaticResource Accent2Brush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Status}" Value="Down">
                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                <Setter Property="Foreground" Value="#808080"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="2" Margin="0,10,0,0"
                    Style="{StaticResource GhostBtn}"
                    Command="{Binding RefreshCmd}"
                    IsEnabled="{Binding NotBusy}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔄" Margin="0,0,6,0"/>
                <TextBlock Text="Aggiorna Schede"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Info scheda selezionata -->
        <Border Grid.Row="2" CornerRadius="12" Padding="16"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="INFORMAZIONI ATTUALI"
                         Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="10"/>
            </StackPanel>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,6">
                <TextBlock Text="IP ATTUALE" Foreground="{StaticResource TextDimBrush}"
                           FontFamily="Consolas" FontSize="9" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding SelectedAdapter.IpAddress, FallbackValue='—'}"
                           Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12"/>
              </StackPanel>
              <StackPanel Margin="0,0,0,6">
                <TextBlock Text="SUBNET" Foreground="{StaticResource TextDimBrush}"
                           FontFamily="Consolas" FontSize="9" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding SelectedAdapter.SubnetMask, FallbackValue='—'}"
                           Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12"/>
              </StackPanel>
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="GATEWAY" Foreground="{StaticResource TextDimBrush}"
                           FontFamily="Consolas" FontSize="9" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding SelectedAdapter.Gateway, FallbackValue='—'}"
                           Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="DHCP" Foreground="{StaticResource TextDimBrush}"
                           FontFamily="Consolas" FontSize="9" Margin="0,0,0,2"/>
                <TextBlock Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="✅ Abilitato"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedAdapter.IsDhcp}" Value="False">
                          <Setter Property="Text" Value="❌ Disabilitato"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Colonna destra: config + script -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="12" Padding="20"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="CONFIGURAZIONE IP"
                         Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="10"/>
            </StackPanel>

            <UniformGrid Columns="2" Margin="0,0,0,16">
              <RadioButton Style="{StaticResource ModeToggle}"
                           IsChecked="{Binding DhcpMode, Mode=OneWay}"
                           Click="DhcpRadio_Click"
                           Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="⚡" Margin="0,0,6,0"/>
                  <TextBlock Text="IP Automatico (DHCP)"/>
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource ModeToggle}"
                           IsChecked="{Binding StaticMode, Mode=OneWay}"
                           Click="StaticRadio_Click"
                           Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="✏️" Margin="0,0,6,0"/>
                  <TextBlock Text="IP Manuale (Statico)"/>
                </StackPanel>
              </RadioButton>
            </UniformGrid>

            <Grid Visibility="{Binding StaticMode, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition Height="10"/><RowDefinition/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Column="0" Grid.Row="0">
                <TextBlock Text="INDIRIZZO IP" Foreground="{StaticResource TextDimBrush}"
                           FontFamily="Consolas" FontSize="9" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource FieldBox}"
                         Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Grid.Row="0">
                <TextBlock Text="SUBNET MASK" Foreground="{StaticResource TextDimBrush}"
                           FontFamily="Consolas" FontSize="9" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource FieldBox}"
                         Text="{Binding Subnet, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="0" Grid.Row="2">
                <TextBlock Text="GATEWAY" Foreground="{StaticResource TextDimBrush}"
                           FontFamily="Consolas" FontSize="9" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource FieldBox}"
                         Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <Grid Grid.Column="2" Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="DNS PRIMARIO" Foreground="{StaticResource TextDimBrush}"
                             FontFamily="Consolas" FontSize="9" Margin="0,0,0,4"/>
                  <TextBox Style="{StaticResource FieldBox}"
                           Text="{Binding Dns1, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="DNS SECONDARIO" Foreground="{StaticResource TextDimBrush}"
                             FontFamily="Consolas" FontSize="9" Margin="0,0,0,4"/>
                  <TextBox Style="{StaticResource FieldBox}"
                           Text="{Binding Dns2, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
              </Grid>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Style="{StaticResource PrimaryBtn}"
                      Command="{Binding ApplyCmd}"
                      IsEnabled="{Binding NotBusy}"
                      Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="▶" Margin="0,0,6,0"/>
                  <TextBlock Text="Applica Configurazione"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource GhostBtn}" Command="{Binding CopyCmd}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="📋" Margin="0,0,6,0"/>
                  <TextBlock Text="Copia Script"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" CornerRadius="12" Padding="16"
                Background="#050810"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
              <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="SCRIPT POWERSHELL GENERATO"
                         Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="10"/>
            </StackPanel>
            <TextBox Grid.Row="1"
                     Text="{Binding GeneratedScript, Mode=OneWay}"
                     Background="Transparent" Foreground="#7ABCDE"
                     FontFamily="Consolas" FontSize="11"
                     IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Padding="2"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- LOG -->
    <Border Grid.Row="2" CornerRadius="12" Padding="14,10" Margin="0,16,0,0"
            Background="#050810"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            MaxHeight="130">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
          <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Text="LOG OPERAZIONI"
                     Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="10"/>
        </StackPanel>
        <TextBox Grid.Row="1"
                 Text="{Binding Log, Mode=OneWay}"
                 Background="Transparent" Foreground="#7ABCDE"
                 FontFamily="Consolas" FontSize="11"
                 IsReadOnly="True" BorderThickness="0"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
      </Grid>
    </Border>

  </Grid>
</Window>
